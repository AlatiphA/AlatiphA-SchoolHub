rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function noDownloadTokenWrite() {
      return request.resource == null || (!('firebaseStorageDownloadTokens' in request.resource.metadata)
        && (!('schoolhubPrivateTokenHash' in request.resource.metadata)
          || (resource != null && request.resource.metadata.schoolhubPrivateTokenHash == resource.metadata.get('schoolhubPrivateTokenHash', ''))));
    }

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isMember(schoolId) {
      return signedIn()
        && myUser().schoolId == schoolId
        && myUser().status == 'active';
    }

    function isHeadTeacher(schoolId) {
      return signedIn()
        && myUser().schoolId == schoolId
        && myUser().role == 'headteacher'
        && myUser().status == 'active';
    }

    // Older student photos can remain under the student's former class path.
    // A teacher may read that binary only when the Student record currently
    // belongs to one of the teacher's assigned classes.
    function isCurrentAssignedStudent(schoolId, studentId) {
      return isActiveTeacherForStorage(schoolId)
        && firestore.get(
          /databases/(default)/documents/schools/$(schoolId)/students/$(studentId)
        ).data.classId in myUser().assignedClassIds;
    }

    match /schools/{schoolId}/student-photos/{classId}/{fileName} {
      allow read: if isMember(schoolId)
        && (
          isHeadTeacher(schoolId)
          || isCurrentAssignedStudent(schoolId, fileName)
        );
      allow write: if noDownloadTokenWrite() && (isHeadTeacher(schoolId) || (isActiveTeacherForStorage(schoolId)
        && classId in myUser().assignedClassIds
        && (!firestore.exists(/databases/(default)/documents/schools/$(schoolId)/students/$(fileName))
          || isCurrentAssignedStudent(schoolId, fileName))));
      allow delete: if isHeadTeacher(schoolId) || (isActiveTeacherForStorage(schoolId)
        && classId in myUser().assignedClassIds
        && (!firestore.exists(/databases/(default)/documents/schools/$(schoolId)/students/$(fileName))
          || isCurrentAssignedStudent(schoolId, fileName)));
    }

    function isActiveTeacherForStorage(schoolId) {
      return signedIn()
        && myUser().schoolId == schoolId
        && myUser().role == 'teacher'
        && myUser().status == 'active'
        && myUser().assignedClassIds is list;
    }

    match /schools/{schoolId}/{assetType}/{fileName} {
      allow read: if isMember(schoolId);
      allow write: if noDownloadTokenWrite() && isHeadTeacher(schoolId);
      allow delete: if isHeadTeacher(schoolId);
    }
  }
}
