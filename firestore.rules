rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isHeadTeacher(schoolId) {
      return signedIn()
        && myUser().schoolId == schoolId
        && myUser().role == 'headteacher'
        && myUser().status == 'active';
    }

    function isActiveTeacher(schoolId) {
      return signedIn()
        && myUser().schoolId == schoolId
        && myUser().role == 'teacher'
        && myUser().status == 'active';
    }

    function hasClass(schoolId, classId) {
      return isActiveTeacher(schoolId)
        && myUser().assignedClassIds is list
        && classId in myUser().assignedClassIds;
    }

    function hasSubject(schoolId, subjectId) {
      return isActiveTeacher(schoolId)
        && myUser().assignedSubjectIds is list
        && subjectId in myUser().assignedSubjectIds;
    }

    // A student's image manifest may retain an older classId after promotion.
    // Authorize by the student's CURRENT class as well as the manifest class.
    function hasCurrentStudent(schoolId, studentId) {
      return isActiveTeacher(schoolId)
        && studentId is string
        && exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(studentId))
        && hasClass(
          schoolId,
          get(/databases/$(database)/documents/schools/$(schoolId)/students/$(studentId)).data.classId
        );
    }

    function notDeleted(schoolId, collection, id) {
      return !existsAfter(/databases/$(database)/documents/schools/$(schoolId)/deletedRecords/$(collection + '__' + id));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isHeadTeacher(resource.data.schoolId));

      // Head Teacher creation remains client-authorized. Teacher join/rejoin is
      // server-only through joinSchoolWithCodeSafe so duplicate identities can
      // be checked atomically before a membership is created.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'headteacher'
        && request.resource.data.status == 'active'
        && request.resource.data.schoolId != null
        && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == uid;
      // A user may refresh only their own display name. Login email changes
      // and membership fields are reconciled by trusted server Functions.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']); // Login email reconciliation is server-owned.
      allow delete: if false;
    }

    // Notifications / Communication v1. Notification content is created by
    // trusted Cloud Functions. A signed-in user can read only their own
    // notifications and can change only read/readAt when acknowledging one.
    match /users/{uid}/notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;
    }

    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      // A school's owner must be able to create the initial join code even
      // when users/{uid} does not exist yet. This is important for account
      // recovery and for first-time school creation. Once the user profile
      // exists, normal Head Teacher management still applies.
      allow create: if signedIn()
        && request.resource.data.schoolId != null
        && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
        && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == request.auth.uid;

      allow update: if isHeadTeacher(resource.data.schoolId)
        && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isHeadTeacher(resource.data.schoolId);
    }

    match /schools/{schoolId} {
      allow read: if signedIn()
        && (
          isHeadTeacher(schoolId)
          || isActiveTeacher(schoolId)
          || (
            myUser().schoolId == schoolId
            && myUser().status == 'pending'
          )
        );

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.profile.schoolName is string;

      // Older clients must not publish blank startup defaults over real Setup.
      allow update: if isHeadTeacher(schoolId) && request.resource.data.ownerUid == resource.data.ownerUid
        && (!(resource.data.get('profile', {}).get('schoolName', '') != '') || request.resource.data.get('profile', {}).get('schoolName', '') != '')
        && (!(resource.data.get('profile', {}).get('currentYear', '') != '') || request.resource.data.get('profile', {}).get('currentYear', '') != '')
        && (!(resource.data.get('profile', {}).get('currentTerm', '') != '') || request.resource.data.get('profile', {}).get('currentTerm', '') != '');
      // Normalized-email identity locks are written only by trusted Functions.
      match /identityEmails/{emailHash} {
        allow read, write: if false;
      }
      match /profileRecovery/{backupId} {
        allow read: if isHeadTeacher(schoolId);
        allow write: if false;
      }
      allow delete: if false;

      match /deletedRecords/{markerId} {
        allow read: if isHeadTeacher(schoolId) || isActiveTeacher(schoolId);
        allow create: if request.resource.data.collection in ['classes','subjects','students','staff','grades','attendance','remarks','teacherAttendance','schoolCalendar']
          && markerId == request.resource.data.collection + '__' + request.resource.data.id
          && (isHeadTeacher(schoolId) || (request.resource.data.collection == 'students'
            && hasClass(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.id)).data.classId)));
        allow update: if isHeadTeacher(schoolId)
          && request.resource.data.collection == resource.data.collection
          && request.resource.data.id == resource.data.id;
        allow delete: if isHeadTeacher(schoolId);
      }

      // Weekly supervision is managed by authenticated callable Functions.
      match /weeklySupervision/{id} { allow read, write: if false; }
      match /supervisionReceipts/{id} { allow read, write: if false; }
      match /supervisionHistory/{id} { allow read, write: if false; }
      // Operations balances, settlements, requests and idempotency receipts are server-owned.
      match /{operationsCollection}/{recordId} {
        allow read, write: if operationsCollection in ['opItems','opAssets','opLiabilities','opRequests','opHistory','opSettlements','opCodes','opReceipts'] && false;
      }
      match /classes/{classId} {
        allow read: if isHeadTeacher(schoolId) || hasClass(schoolId, classId);
        allow create: if isHeadTeacher(schoolId) && notDeleted(schoolId, 'classes', classId);
        allow update, delete: if isHeadTeacher(schoolId);
      }

      match /students/{studentId} {
        allow read: if isHeadTeacher(schoolId) || hasClass(schoolId, resource.data.classId);
        allow create: if notDeleted(schoolId, 'students', studentId) && (isHeadTeacher(schoolId)
          || hasClass(schoolId, request.resource.data.classId));
        allow update: if isHeadTeacher(schoolId)
          || (
            hasClass(schoolId, resource.data.classId)
            && request.resource.data.classId == resource.data.classId
          );
        allow delete: if isHeadTeacher(schoolId)
          || hasClass(schoolId, resource.data.classId);
      }

      match /subjects/{subjectId} {
        allow read: if isHeadTeacher(schoolId) || hasSubject(schoolId, subjectId);
        allow create: if isHeadTeacher(schoolId) && notDeleted(schoolId, 'subjects', subjectId);
        allow update, delete: if isHeadTeacher(schoolId);
      }

      match /grades/{gradeId} {
        allow read: if isHeadTeacher(schoolId) || hasClass(schoolId, resource.data.classId);
        allow create, update: if false;
        allow delete: if isHeadTeacher(schoolId);
      }

      match /attendance/{attendanceId} {
        allow read: if isHeadTeacher(schoolId) || hasClass(schoolId, resource.data.classId);
        allow create, update: if false;
        allow delete: if isHeadTeacher(schoolId);

      }

      match /teacherAttendance/{attendanceId} {
        allow read: if isHeadTeacher(schoolId);
        allow create, update: if false;
        allow delete: if isHeadTeacher(schoolId);

      }

      match /schoolCalendar/{calendarId} {
        allow read: if isHeadTeacher(schoolId) || isActiveTeacher(schoolId);
        allow create, update, delete: if isHeadTeacher(schoolId);
      }

      match /remarks/{remarkId} {
        allow read: if isHeadTeacher(schoolId) || hasClass(schoolId, resource.data.classId);
        allow create, update: if false;
        allow delete: if isHeadTeacher(schoolId);

      }

      match /teacherLinks/{teacherUid} {
        allow read: if isHeadTeacher(schoolId);
        allow write: if false;
      }

      match /staff/{staffId} {
        allow read: if isHeadTeacher(schoolId);
        allow create: if isHeadTeacher(schoolId) && notDeleted(schoolId, 'staff', staffId)
          && request.resource.data.get('userUid', '') in ['', request.auth.uid];
        allow update: if isHeadTeacher(schoolId)
          && (request.resource.data.get('userUid', '') == resource.data.get('userUid', '')
            || (request.resource.data.get('userUid', '') == request.auth.uid && resource.data.get('userUid', '') == ''));
        allow delete: if isHeadTeacher(schoolId);
      }

      // v35: school activity/audit log. Head Teachers can read the whole
      // school's log. Active teachers can read only their own actions.
      // Phase 4 billing. Client users can read the school's balance, but
      // credit purchases and credit consumption are performed only by
      // Firebase Cloud Functions so clients cannot mint or edit credits.
      match /billing/{billingId} {
        allow read: if isHeadTeacher(schoolId) || (billingId == 'account' && isActiveTeacher(schoolId));
        allow write: if false;
      }

      match /billingTransactions/{transactionId} {
        allow read: if isHeadTeacher(schoolId);
        allow write: if false;
      }

      match /billingUsage/{usageId} {
        allow read: if isHeadTeacher(schoolId);
        allow write: if false;
      }

      // FIS v40 upgrade. Fee administration contains payer and financial data.
      // Clients never read or mutate these collections directly. Active Head
      // Teachers use authenticated Cloud Functions, while teachers receive only
      // the class balance map required for report cards.
      match /feeCategories/{feeId} { allow read, write: if false; }
      match /feeItems/{feeId} { allow read, write: if false; }
      match /pupilCharges/{chargeId} { allow read, write: if false; }
      match /feeAccounts/{accountId} { allow read, write: if false; }
      match /feePayments/{paymentId} { allow read, write: if false; }
      match /feeEvents/{eventId} { allow read, write: if false; }
      match /feeMeta/{metaId} { allow read, write: if false; }

      match /activity/{activityId} {
        allow read: if isHeadTeacher(schoolId)
          || (isActiveTeacher(schoolId) && resource.data.uid == request.auth.uid);
        allow create: if (isHeadTeacher(schoolId) || isActiveTeacher(schoolId))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == myUser().role;
        allow update, delete: if false;
      }

      // Immutable academic-year rollover archive. Only the active Head Teacher
      // may create/read snapshots. Once created, they cannot be edited or deleted.
      match /yearRollovers/{rolloverId} {
        allow read: if isHeadTeacher(schoolId);
        allow create: if false;
        allow update, delete: if false;

        match /snapshot/{chunkId} {
          allow read: if isHeadTeacher(schoolId);
        allow create: if false;
          allow update, delete: if false;
        }
      }

      // v32: Firestore image manifest. Storage contains the binary files; this
      // collection tells each browser exactly which cloud asset belongs to a
      // school record. Teachers may manage manifests only for student photos
      // in their assigned classes. Head Teachers may manage all school assets.
      match /imageAssets/{assetId} {
        allow read: if isHeadTeacher(schoolId) || (isActiveTeacher(schoolId)
          && (
            resource.data.kind in ['logo','staff']
            || (
              resource.data.kind == 'student'
              && (
                hasClass(schoolId, resource.data.classId)
                || hasCurrentStudent(schoolId, resource.data.recordId)
              )
            )
          ));

        allow create: if isHeadTeacher(schoolId)
          || (
            isActiveTeacher(schoolId)
            && request.resource.data.kind == 'student'
            && request.resource.data.classId is string
            && hasClass(schoolId, request.resource.data.classId)
          );

        allow update: if isHeadTeacher(schoolId)
          || (
            isActiveTeacher(schoolId)
            && resource.data.kind == 'student'
            && request.resource.data.kind == 'student'
            && resource.data.recordId is string
            && request.resource.data.recordId == resource.data.recordId
            && request.resource.data.classId is string
            && hasClass(schoolId, request.resource.data.classId)
            && hasCurrentStudent(schoolId, resource.data.recordId)
          );

        allow delete: if isHeadTeacher(schoolId)
          || (
            isActiveTeacher(schoolId)
            && resource.data.kind == 'student'
            && resource.data.recordId is string
            && (
              hasClass(schoolId, resource.data.classId)
              || hasCurrentStudent(schoolId, resource.data.recordId)
            )
          );
      }
    }
  }
}
